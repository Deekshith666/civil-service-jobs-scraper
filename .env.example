# ==============================================================================
# Civil Service Jobs Scraper - Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Account Email (Used for Vercel and GitHub)
USER_EMAIL=your_email@example.com

# GitHub Configuration & Personal Access Token
GITHUB_USERNAME=your_github_username
GITHUB_EMAIL=your_email@example.com
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_URL=https://github.com/your_username/civil-service-jobs-scraper

# Vercel Configuration & Access Token
VERCEL_EMAIL=your_email@example.com
VERCEL_TOKEN=your_vercel_access_token
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id
VERCEL_PROJECT_NAME=civil-service-jobs-scraper
VERCEL_PROJECT_URL=https://civil-service-jobs-scraper.vercel.app

# Optional Cloud Database (PostgreSQL / Neon / Supabase or Turso)
# DATABASE_URL=postgresql://user:password@host/dbname
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
